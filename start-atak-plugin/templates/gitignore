*.apk
*.aab
*.aar
*.dex

# Signing material (scoped to app/, NOT atak-sdks/)
app/**/*.keystore
app/**/*.jks

# OS
.DS_Store
Thumbs.db

# Native build
.cxx/

# takdev workspace
.takdev/

# TPC staging
tpc-staging/
